# tuyaopen-core 开关（经 core 的 Kconfig.projbuild 进 menuconfig 的 tuyaopen-core 菜单）
CONFIG_ENABLE_WIRED=y
CONFIG_ENABLE_QRCODE=y
# 用 esp-idf 的 mbedtls，不编 core 自带副本（避免符号冲突）
CONFIG_ENABLE_PLATFORM_MBEDTLS=y
CONFIG_LITTLE_END=y

# 目标与分区
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# tuya_tls 需要的 mbedtls 能力
CONFIG_MBEDTLS_THREADING_C=y
CONFIG_MBEDTLS_THREADING_ALT=y
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# demo WiFi 凭据：推荐用 idf.py menuconfig（iot_demo 菜单）配置；
# 也可直接填这里（不要提交真实密码）
CONFIG_DEMO_WIFI_SSID=""
CONFIG_DEMO_WIFI_PASSWORD=""
