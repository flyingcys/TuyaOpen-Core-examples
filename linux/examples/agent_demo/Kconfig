menu "configure app (agent_demo)"

    config AGENT_DEMO
        bool
        default y
        select ENABLE_AI_COMPONENTS
        select ENABLE_QRCODE
        help
            构建 linux/examples/agent_demo（云端 AI agent 全链路：上传一段
            语音触发、下行只打印文字；无 UI、下行语音不处理）。
            默认 y：agent_demo 是独立 CMake 工程，本开关只负责把 AI 链路
            依赖的 core 开关（ENABLE_AI_COMPONENTS / ENABLE_QRCODE）
            在共享的 .config 里带起来。本符号无
            prompt（menuconfig 里不可交互关闭），不构建该 example 即可，
            无需关闭此符号。

            注意：本 demo 依赖 ENABLE_QRCODE 输出绑定二维码（未激活设备扫码
            激活的唯一途径）——若在 menuconfig 或 -D 中关闭 ENABLE_QRCODE，
            构建仍会成功，但运行后停在 "Wait Tuya APP scan..." 且无二维码可扫、
            无法激活（1c 评审 R3 实测：二维码块数 0）。正常路径无需关闭。

    config AGENT_DEMO_AUDIO_FILE
        string "Audio source PCM file (empty = bundled voice_16k.pcm)"
        depends on AGENT_DEMO
        default ""
        help
            上行语音素材路径（16kHz/16bit/单声道 PCM）。留空用内置素材
            （构建目录的 voice_16k.pcm，由 assets/voice_16k.pcm 复制而来，
            为 edge-tts 合成的"请问，现在是几点钟？"）；填写则用该文件。

    # 应用侧 AI 组件开关（自 core agent-core 下沉，见 src/components/）：
    # audio_player（ENABLE_AI_PLAYER 及解码器/资源参数子开关）→ ai_audio
    # （ENABLE_COMP_AI_AUDIO + 提示音来源选择，select ENABLE_AI_PLAYER）。
    # 符号名/默认值与原 core 定义一致（.config 与 CMake -D 的既有用法不受
    # 影响）。此处不加 ENABLE_AI_COMPONENTS 门控：AGENT_DEMO（无 prompt、
    # default y）select 该符号使其恒为 y（kconfiglib 实测强制关会被 select
    # 拉回），套 if 是恒真冗余。
    # 注：ENABLE_COMP_AI_MCP 不在此列——MCP server 核心在 core 服务层
    # （agent-core/svc_ai_mcp/），开关随模块定义在那里。
    rsource "src/components/audio_player/Kconfig"
    rsource "src/components/ai_audio/Kconfig"

endmenu
