/**
 * @file tuya_config_secrets.h.example
 * @brief 凭据覆盖模板（复制为 tuya_config_secrets.h 并填入真实值）
 *
 * 该文件被 tuya_config.h 以 __has_include 探测；存在即优先于默认值。
 * 也可用 -DTUYA_PRODUCT_ID=... 或环境变量覆盖（优先级更高）。
 *
 * @copyright Copyright (c) 2021-2026 Tuya Inc. All Rights Reserved.
 */

#ifndef __TUYA_CONFIG_SECRETS_H__
#define __TUYA_CONFIG_SECRETS_H__

#ifdef __cplusplus
extern "C" {
#endif

/* 三个 #define 用 #ifndef 包裹：保证 -D / 环境变量注入优先（与 tuya_config.h
 * 的 #ifndef 链条一致），否则 secrets 会静默覆盖命令行凭据（伴随 redefinition 警告）。
 * 默认 PID 同 tuya_config.h（上游 your_chat_bot 同款 AI 产品）。 */
#ifndef TUYA_PRODUCT_ID
#define TUYA_PRODUCT_ID      "alon7qgyjj8yus74"                        // AI 产品 PID（需开通 AI 服务）
#endif
#ifndef TUYA_OPENSDK_UUID
#define TUYA_OPENSDK_UUID      "uuidxxxxxxxxxxxxxxxx"                  // Please change the correct uuid
#endif
#ifndef TUYA_OPENSDK_AUTHKEY
#define TUYA_OPENSDK_AUTHKEY   "keyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"      // Please change the correct authkey
#endif

#ifdef __cplusplus
}
#endif

#endif /* __TUYA_CONFIG_SECRETS_H__ */
